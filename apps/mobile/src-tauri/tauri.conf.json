{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dray",
  "version": "0.1.0",
  "identifier": "com.yogesh.dray.mobile",
  "build": {
    "beforeDevCommand": "pnpm frontend:dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm frontend:build",
    "frontendDist": "../../desktop/dist-mobile"
  },
  "app": {
    "windows": [
      {
        "title": "Dray",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
